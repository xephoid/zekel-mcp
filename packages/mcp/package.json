{
  "name": "@zekel/mcp",
  "version": "0.1.1",
  "description": "A bare MCP server for turn-based board games: sessions, seats, moves, AI turns, multi-device join. Holds no game rules; games are registered from outside.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xephoid/zekel-mcp.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/xephoid/zekel-mcp#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@zekel/game-kit": "workspace:*",
    "express": "5.2.1",
    "mongodb": "7.3.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
